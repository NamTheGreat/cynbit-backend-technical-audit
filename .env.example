# Cynbit Production & Staging Environment Configuration
# Remediates OPS-01: Guaranteed HTTPS and strictly non-localhost in production

NODE_ENV=development
PORT=3000

# Canonical Public Portal URL (strictly validated by Zod at boot-time)
PUBLIC_PORTAL_BASE_URL=https://cynbit.in

# PostgreSQL Database Connection URL (Prisma ORM)
DATABASE_URL=postgresql://cynbit_user:secure_password_here@localhost:5432/cynbit_production?schema=public&sslmode=prefer

# Redis Cache & Sliding-Window Rate Limiting URL
REDIS_URL=redis://:redis_password_here@localhost:6379/0

# HMAC-SHA256 Secret for Candidate Session Cookies (Min 256 bits / 32 characters)
PORTAL_SESSION_SECRET=cynbit_super_secure_production_portal_session_secret_2026_at_least_32_bytes_long

# AWS Simple Email Service (SES) Region & Verified Sender Address
AWS_SES_REGION=ap-south-1
AWS_SES_FROM_EMAIL=opportunities@cynbit.in
